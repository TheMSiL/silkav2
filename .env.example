# Public site origin — used for canonicals, OG URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL="https://keel.studio"

# Lead notifications (optional).
# Without both values the notifier is a no-op and submissions still succeed.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Lead storage (optional).
# Unset: leads append to .data/leads.jsonl, with a console fallback on
# read-only filesystems. Set it after wiring PrismaLeadRepository — see
# prisma/schema.prisma.
DATABASE_URL=""
